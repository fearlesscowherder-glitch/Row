# Copy this file to .env (same folder) and fill it in. .env is never committed.

# Any password you make up. Pages ask for it once per device.
APP_PASSWORD=

# Supabase (step 1 in SETUP.md)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Schoology link that works without logging in. If Schoology only
# downloads a file, leave this empty: the app imports exports from Downloads.
SCHOOLOGY_ICAL_URL=

# AI through OmniRoute running on this computer.
# Create a key in the OmniRoute dashboard (Endpoints / API Keys) and pick a
# model or combo name it lists. Leave AI_BASE_URL empty to use ANTHROPIC_API_KEY instead.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=auto
# Optional: a model that can see images, used for tagging pictures in Mind
# AI_VISION_MODEL=
# ANTHROPIC_API_KEY=

# Gmail (step 4): your address + an app password from myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional
# PORT=3210
# SYNC_MINUTES=15
# TZ_NAME=America/New_York
